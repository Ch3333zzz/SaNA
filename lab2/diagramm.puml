@startuml
left to right direction
skinparam DefaultFontName sans-serif
skinparam NodeBackgroundColor #F8F9FA
skinparam NodeBorderColor #333333

node "r1" as r1
node "r2" as r2
node "r3" as r3
node "r4" as r4
node "r5" as r5
node "r6" as r6

r1 --- r2 : "eth1: 10.0.12.1 --- eth1: 10.0.12.2"
r2 --- r3 : "eth2: 10.0.23.1 --- eth1: 10.0.23.2"
r3 --- r1 : "eth2: 10.0.13.2 --- eth2: 10.0.13.1"
r2 --- r4 : "eth3: 10.0.24.1 --- eth1: 10.0.24.2"
r1 --- r5 : "eth3: 10.0.15.2 --- eth1: 10.0.15.1"
r4 --- r5 : "eth3: 10.0.45.2 --- eth2: 10.0.45.1"
r5 --- r6 : "eth3: 10.0.56.1 --- eth1: 10.0.56.2"

r1 --- r1 : "lo: 10.0.1.1"
r2 --- r2 : "lo: 10.0.1.2"
r3 --- r3 : "lo: 10.0.1.3"
r4 --- r4 : "lo: 10.0.1.4"
r5 --- r5 : "lo: 10.0.1.5"
r6 --- r6 : "lo: 10.0.1.6"

@enduml
